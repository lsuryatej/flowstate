{
  "name": "flowstate",
  "private": true,
  "description": "A desktop companion for Claude Code, built for ADHD brains.",
  "repository": {
    "type": "git",
    "url": "https://github.com/lsuryatej/flowstate.git"
  },
  "author": "Suryatej Lalam",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lsuryatej/flowstate/issues"
  },
  "homepage": "https://github.com/lsuryatej/flowstate#readme",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:sidecar": "esbuild sidecar/index.ts --bundle --platform=node --format=esm --outfile=sidecar/dist/index.js --external:@anthropic-ai/claude-agent-sdk",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.226",
    "@fontsource-variable/outfit": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "lint-staged": "^17.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
